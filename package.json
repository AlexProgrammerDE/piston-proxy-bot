{
  "name": "piston-proxy-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/build-worker.sh && cf dev",
    "build": "./scripts/build-worker.sh && cf build",
    "deploy": "bun run build && cf deploy --prebuilt",
    "cf-typegen": "cf workers types",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install",
    "pre-commit": "lefthook run pre-commit"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.0",
    "cf": "1.0.0-rc.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "vite": "8.0.13"
  }
}
