{
  "name": "piston-proxy-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/build-worker.sh && cf dev",
    "build": "./scripts/build-worker.sh && cf build",
    "deploy": "bun run build && cf deploy --prebuilt",
